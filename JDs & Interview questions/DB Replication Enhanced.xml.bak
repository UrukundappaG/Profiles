<mxfile host="app.diagrams.net">
  <diagram name="Azure Multi-Region Zero Trust Architecture">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Users -->
        <mxCell id="user" value="Users&#10;(Internet / Corp)"
          style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;"
          vertex="1" parent="1">
          <mxGeometry x="620" y="20" width="260" height="60" as="geometry"/>
        </mxCell>

        <!-- Front Door -->
        <mxCell id="afd" value="Azure Front Door (WAF)&#10;Zero Trust Entry"
          style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;"
          vertex="1" parent="1">
          <mxGeometry x="620" y="110" width="260" height="70" as="geometry"/>
        </mxCell>

        <!-- East VNET -->
        <mxCell id="eastVNET" value="East US VNET"
          style="swimlane;fillColor=#f5f5f5;strokeColor=#666666;"
          vertex="1" parent="1">
          <mxGeometry x="80" y="230" width="500" height="420" as="geometry"/>
        </mxCell>

        <!-- West VNET -->
        <mxCell id="westVNET" value="West US VNET"
          style="swimlane;fillColor=#f5f5f5;strokeColor=#666666;"
          vertex="1" parent="1">
          <mxGeometry x="620" y="230" width="500" height="420" as="geometry"/>
        </mxCell>

        <!-- East Components -->
        <mxCell id="eastAPIM" value="API Management&#10;(Internal Mode)"
          style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;"
          vertex="1" parent="eastVNET">
          <mxGeometry x="150" y="60" width="200" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="eastAPI" value="App Service / AKS&#10;Managed Identity"
          style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;"
          vertex="1" parent="eastVNET">
          <mxGeometry x="150" y="130" width="200" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="eastPE" value="Private Endpoint"
          style="rounded=1;fillColor=#eeeeee;strokeColor=#999999;"
          vertex="1" parent="eastVNET">
          <mxGeometry x="170" y="210" width="160" height="40"
