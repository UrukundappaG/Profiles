<mxfile host="app.diagrams.net">
  <diagram name="Azure Multi-Region Clean Architecture">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Users -->
        <mxCell id="user" value="End Users&#10;(Web / Mobile / Clients)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;"
          vertex="1" parent="1">
          <mxGeometry x="520" y="20" width="240" height="60" as="geometry"/>
        </mxCell>

        <!-- Front Door -->
        <mxCell id="afd" value="Azure Front Door&#10;Global Routing &amp; Health Probes"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;"
          vertex="1" parent="1">
          <mxGeometry x="520" y="110" width="240" height="70" as="geometry"/>
        </mxCell>

        <!-- East Region Container -->
        <mxCell id="eastRegion" value="East US (Primary Write Region)"
          style="swimlane;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;"
          vertex="1" parent="1">
          <mxGeometry x="120" y="230" width="420" height="350" as="geometry"/>
        </mxCell>

        <!-- West Region Container -->
        <mxCell id="westRegion" value="West US (Read / DR Region)"
          style="swimlane;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;"
          vertex="1" parent="1">
          <mxGeometry x="620" y="230" width="420" height="350" as="geometry"/>
        </mxCell>

        <!-- East Components -->
        <mxCell id="eastAPIM" value="API Management"
          style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;"
          vertex="1" parent="eastRegion">
          <mxGeometry x="110" y="50" width="200" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="eastAPI" value="App Service / AKS&#10;(Stateless APIs)"
          style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;"
          vertex="1" parent="eastRegion">
          <mxGeometry x="110" y="120" width="200" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="eastDB" value="Primary Database&#10;(Cosmos DB / Azure SQL)"
          style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;"
          vertex="1" parent="eastRegion">
          <mxGeometry x="90" y="210" width="240" height="70" as="geometry"/>
        </mxCell>

        <!-- West Components -->
        <mxCell id="westAPIM" value="API Management"
          style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;"
          vertex="1" parent="westRegion">
          <mxGeometry x="110" y="50" width="200" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="westAPI" value="App Service / AKS&#10;(Stateless APIs)"
          style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;"
          vertex="1" parent="westRegion">
          <mxGeometry x="110" y="120" width="200" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="westDB" value="Read Replica / Secondary DB"
          style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;"
          vertex="1" parent="westRegion">
          <mxGeometry x="90" y="210" width="240" height="70" as="geometry"/>
        </mxCell>

        <!-- Connections -->
        <mxCell id="c1" style="endArrow=block;" edge="1" parent="1"
          source="user" target="afd">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="c2" style="endArrow=block;" edge="1" parent="1"
          source="afd" target="eastAPIM">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="c3" style="endArrow=block;" edge="1" parent="1"
          source="afd" target="westAPIM">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="c4" style="endArrow=block;" edge="1" parent="1"
          source="eastAPIM" target="eastAPI">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="c5" style="endArrow=block;" edge="1" parent="1"
          source="eastAPI" target="eastDB">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="c6" style="endArrow=block;" edge="1" parent="1"
          source="westAPIM" target="westAPI">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="c7" style="endArrow=block;dashed=1;" edge="1" parent="1"
          source="eastDB" target="westDB">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
