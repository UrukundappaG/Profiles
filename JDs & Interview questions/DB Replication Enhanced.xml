<mxfile host="app.diagrams.net">
  <diagram name="Azure Multi-Region Zero Trust Architecture">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Users -->
        <mxCell id="user" value="Users&#10;(Internet / Corp)"
          style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;"
          vertex="1" parent="1">
          <mxGeometry x="620" y="20" width="260" height="60" as="geometry"/>
        </mxCell>

        <!-- Front Door -->
        <mxCell id="afd" value="Azure Front Door (WAF)&#10;Zero Trust Entry"
          style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;"
          vertex="1" parent="1">
          <mxGeometry x="620" y="110" width="260" height="70" as="geometry"/>
        </mxCell>

        <!-- East VNET -->
        <mxCell id="eastVNET" value="East US VNET"
          style="swimlane;fillColor=#f5f5f5;strokeColor=#666666;"
          vertex="1" parent="1">
          <mxGeometry x="80" y="230" width="500" height="420" as="geometry"/>
        </mxCell>

        <!-- West VNET -->
        <mxCell id="westVNET" value="West US VNET"
          style="swimlane;fillColor=#f5f5f5;strokeColor=#666666;"
          vertex="1" parent="1">
          <mxGeometry x="620" y="230" width="500" height="420" as="geometry"/>
        </mxCell>

        <!-- East Components -->
        <mxCell id="eastAPIM" value="API Management&#10;(Internal Mode)"
          style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;"
          vertex="1" parent="eastVNET">
          <mxGeometry x="150" y="60" width="200" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="eastAPI" value="App Service / AKS&#10;Managed Identity"
          style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;"
          vertex="1" parent="eastVNET">
          <mxGeometry x="150" y="130" width="200" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="eastPE" value="Private Endpoint"
          style="rounded=1;fillColor=#eeeeee;strokeColor=#999999;"
          vertex="1" parent="eastVNET">
          <mxGeometry x="170" y="210" width="160" height="40" as="geometry"/>
        </mxCell>

        <!-- West Components -->
        <mxCell id="westAPIM" value="API Management&#10;(Internal Mode)"
          style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;"
          vertex="1" parent="westVNET">
          <mxGeometry x="150" y="60" width="200" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="westAPI" value="App Service / AKS&#10;Managed Identity"
          style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;"
          vertex="1" parent="westVNET">
          <mxGeometry x="150" y="130" width="200" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="westPE" value="Private Endpoint"
          style="rounded=1;fillColor=#eeeeee;strokeColor=#999999;"
          vertex="1" parent="westVNET">
          <mxGeometry x="170" y="210" width="160" height="40" as="geometry"/>
        </mxCell>

        <!-- Cosmos DB -->
        <mxCell id="cosmos" value="Azure Cosmos DB&#10;Multi-Write Enabled&#10;Session Consistency"
          style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;"
          vertex="1" parent="1">
          <mxGeometry x="420" y="700" width="360" height="90" as="geometry"/>
        </mxCell>

        <!-- Failover Listener -->
        <mxCell id="listener" value="Cosmos DB Global Endpoint&#10;(Automatic Failover)"
          style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;"
          vertex="1" parent="1">
          <mxGeometry x="420" y="600" width="360" height="60" as="geometry"/>
        </mxCell>

        <!-- Connections -->
        <mxCell id="c1" style="endArrow=block;" edge="1" parent="1"
          source="user" target="afd">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="c2" style="endArrow=block;" edge="1" parent="1"
          source="afd" target="eastAPIM">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="c3" style="endArrow=block;" edge="1" parent="1"
          source="afd" target="westAPIM">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="c4" style="endArrow=block;" edge="1" parent="1"
          source="eastAPIM" target="eastAPI">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="c5" style="endArrow=block;" edge="1" parent="1"
          source="westAPIM" target="westAPI">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="c6" style="endArrow=block;" edge="1" parent="1"
          source="eastAPI" target="eastPE">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="c7" style="endArrow=block;" edge="1" parent="1"
          source="westAPI" target="westPE">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="c8" style="endArrow=block;" edge="1" parent="1"
          source="eastPE" target="listener">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="c9" style="endArrow=block;" edge="1" parent="1"
          source="westPE" target="listener">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="c10" style="endArrow=block;dashed=1;" edge="1" parent="1"
          source="listener" target="cosmos">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
